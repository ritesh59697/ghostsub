# Tatum Gateway API (Get free key at dashboard.tatum.io)
TATUM_API_KEY=your_tatum_api_key_here
NEXT_PUBLIC_TATUM_RPC_URL=https://sui-mainnet.gateway.tatum.io

# Walrus Memory on Mainnet (memory.walrus.xyz/dashboard)
# MEMWAL_AGENT_ID is the public key under "Delegate keys" in that dashboard.
MEMWAL_ACCOUNT_ID=your_memwal_account_id_here
MEMWAL_AGENT_ID=your_delegate_key_public_key_here
MEMWAL_PRIVATE_KEY=your_server_side_delegate_key_here
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Namespaces counted by the public /api/ledger proof route (comma separated).
# These should hold the submission's durable Mainnet memories so a reviewer can
# verify the count without using the demo's browser-scoped profile.
GHOSTSUB_LEDGER_NAMESPACES=ghostsub-production
